		"name": "Project-SPM - US02 Itinerary Stops",
		"description": "Postman Collection for US02 (Add and edit geolocated fixed stops of an itinerary)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
