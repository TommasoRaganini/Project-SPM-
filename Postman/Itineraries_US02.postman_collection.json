						"value": "editor-1"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Piazza del Campo (Updated)\",\n  \"description\": \"Updated description with historical details.\",\n  \"latitude\": 43.3188,\n  \"longitude\": 11.3308\n}"
				},
