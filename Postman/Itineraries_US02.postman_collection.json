	"item": [
		{
			"name": "1. Create Draft Itinerary (Prerequisite)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"if (jsonData.id) {",
							"    pm.environment.set('itinerary_id', jsonData.id);",
							"    pm.collectionVariables.set('itinerary_id', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Editor-Id",
						"value": "editor-1"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Tuscan Heritage Route\",\n  \"theme\": \"History\",\n  \"description\": \"Exploring central Tuscany medieval routes.\",\n  \"geographicalArea\": \"Tuscany, Siena\"\n}"
				},
				"url": {
					"raw": "http://localhost:5207/api/itineraries",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5207",
					"path": [
						"api",
						"itineraries"
					]
				}
			}
		},
		{
			"name": "2. Add Stop to Draft (AC01, AC02)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('Stop has valid coordinates', function () {",
							"    pm.expect(jsonData.latitude).to.eql(43.3188);",
							"    pm.expect(jsonData.longitude).to.eql(11.3308);",
							"});",
							"if (jsonData.id) {",
							"    pm.environment.set('created_stop_id', jsonData.id);",
							"    pm.collectionVariables.set('created_stop_id', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Editor-Id",
						"value": "editor-1"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Piazza del Campo\",\n  \"description\": \"Historic town square of Siena famous for the Palio horse race.\",\n  \"latitude\": 43.3188,\n  \"longitude\": 11.3308\n}"
				},
				"url": {
					"raw": "http://localhost:5207/api/itineraries/{{itinerary_id}}/stops",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5207",
					"path": [
						"api",
						"itineraries",
						"{{itinerary_id}}",
						"stops"
					]
				}
			}
		},
		{
			"name": "3. Get Itinerary Stops (AC02)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Stops collection is not empty', function () {",
							"    pm.expect(jsonData.length).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5207/api/itineraries/{{itinerary_id}}/stops",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5207",
					"path": [
						"api",
						"itineraries",
						"{{itinerary_id}}",
						"stops"
					]
				}
			}
		},
		{
			"name": "4. Update Stop (AC03)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Stop name and details are updated', function () {",
							"    pm.expect(jsonData.name).to.eql('Piazza del Campo (Updated)');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
